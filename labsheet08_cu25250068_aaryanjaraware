class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None
def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    elif data > root.data:
        root.right = insert(root.right, data)

    return root
def delete(root, data):
    if root is None:
        return None

    if data < root.data:
        root.left = delete(root.left, data)
    elif data > root.data:
        root.right = delete(root.right, data)
    else:
        if root.left is None:
            return root.right
        if root.right is None:
            return root.left

        temp = root.right
        while temp.left:
            temp = temp.left

        root.data = temp.data
        root.right = delete(root.right, temp.data)

    return root
def height(root):
    if root is None:
        return 0
    return 1 + max(height(root.left), height(root.right))

def display(root):
    if root is None:
        print("Tree is empty")
        return

    h = height(root)
    unit = 6
    width = (2 ** h) * unit
    canvas = [[" "] * width for _ in range(2 * h - 1)]

    def draw(node, level, pos):
        if node is None:
            return

        col = (2 * pos + 1) * (2 ** (h - level - 1)) * unit // 2

        text = str(node.data)
        start = col - len(text) // 2

        for i, ch in enumerate(text):
            if 0 <= start + i < width:
                canvas[level * 2][start + i] = ch

        if level == h - 1:
            return

        gap = (2 ** (h - level - 2)) * unit

        if node.left:
            child_col = col - gap
            
            branch_col = (col + child_col) // 2
            if 0 <= branch_col < width:
                canvas[level * 2 + 1][branch_col] = "/"
            draw(node.left, level + 1, pos * 2)

        if node.right:
            child_col = col + gap
            branch_col = (col + child_col) // 2
            if 0 <= branch_col < width:
                canvas[level * 2 + 1][branch_col] = "\\"
            draw(node.right, level + 1, pos * 2 + 1)

    draw(root, 0, 0)

    for line in canvas:
        print("".join(line).rstrip())

root = None

n = int(input("How many nodes? "))

for i in range(n):
    value = int(input("Enter value: "))
    root = insert(root, value)

print("\nBST:")
display(root)

value = int(input("\nEnter value to delete: "))
root = delete(root, value)

print("\nBST after deletion:")
display(root)
